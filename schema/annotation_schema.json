{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/financial-document-annotation.schema.json",
  "title": "Financial Document Annotation Schema",
  "description": "Schema for classifying financial documents and extracting entities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_metadata",
    "classification",
    "entities",
    "relationships",
    "quality_metadata",
    "version_control"
  ],
  "properties": {
    "document_metadata": {
      "type": "object",
      "required": [
        "document_id",
        "source_file_path",
        "creation_date",
        "last_modified",
        "assigned_annotator",
        "review_status"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_file_path": {
          "type": "string"
        },
        "creation_date": {
          "type": "string",
          "format": "date"
        },
        "last_modified": {
          "type": "string",
          "format": "date-time"
        },
        "assigned_annotator": {
          "type": "string"
        },
        "review_status": {
          "type": "string",
          "enum": ["PENDING", "IN_REVIEW", "APPROVED", "REJECTED"]
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "primary_type",
        "subtype",
        "quality_tags",
        "confidence_scores"
      ],
      "properties": {
        "primary_type": {
          "type": "string",
          "enum": [
            "BANK_STATEMENTS",
            "COMMERCIAL_INVOICES",
            "INCOME_TAX_RETURNS",
            "LOAN_AGREEMENTS",
            "INSURANCE_POLICIES",
            "REGULATORY_FILINGS",
            "PAYMENT_RECEIPTS",
            "FINANCIAL_STATEMENTS"
          ]
        },
        "subtype": {
          "type": "string",
          "minLength": 1
        },
        "quality_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "CLEAN_DIGITAL",
              "OCR_HIGH_QUALITY",
              "OCR_DEGRADED",
              "OCR_NOISY",
              "MULTI_LANGUAGE",
              "MULTI_CURRENCY",
              "HANDWRITTEN_ELEMENTS",
              "REDACTED",
              "TEMPLATE_MISMATCH",
              "INCOMPLETE"
            ]
          }
        },
        "confidence_scores": {
          "type": "object",
          "properties": {
            "primary_type": {
              "$ref": "#/$defs/confidence"
            },
            "subtype": {
              "$ref": "#/$defs/confidence"
            }
          },
          "required": ["primary_type", "subtype"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "entity_type",
          "value",
          "normalized_value",
          "source_text",
          "page_number",
          "bounding_box",
          "confidence",
          "ocr_quality_flag",
          "linked_entities",
          "annotator_notes"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "MONETARY_AMOUNT",
              "DATE",
              "ACCOUNT_NUMBER",
              "PARTY_NAME",
              "REGULATORY_ID",
              "ADDRESS",
              "INTEREST_RATE",
              "DURATION",
              "PERCENTAGE",
              "DOCUMENT_ID",
              "CLAUSE_REFERENCE",
              "TRANSACTION_TYPE",
              "INSTITUTION_NAME",
              "PRODUCT_NAME",
              "STATUS",
              "CONTACT_INFO",
              "SIGNATURE_BLOCK",
              "TABLE_DATA",
              "COMPUTATION",
              "FOOTNOTE_REF",
              "CURRENCY_CODE",
              "FISCAL_PERIOD"
            ]
          },
          "value": {
            "type": ["string", "number", "object", "array"]
          },
          "normalized_value": {
            "type": ["string", "number", "object", "array", "null"]
          },
          "source_text": {
            "type": "string"
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "bounding_box": {
            "type": ["object", "null"],
            "properties": {
              "x": {"type": "number", "minimum": 0},
              "y": {"type": "number", "minimum": 0},
              "width": {"type": "number", "minimum": 0},
              "height": {"type": "number", "minimum": 0}
            },
            "required": ["x", "y", "width", "height"],
            "additionalProperties": false
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          },
          "ocr_quality_flag": {
            "type": "string",
            "enum": [
              "CLEAN",
              "HIGH",
              "DEGRADED",
              "NOISY",
              "NOT_APPLICABLE"
            ]
          },
          "linked_entities": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "annotator_notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "relationship_type",
          "source_entity_id",
          "target_entity_id"
        ],
        "properties": {
          "relationship_id": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string",
            "enum": [
              "HOLDER_OF_ACCOUNT",
              "PAYER_OF",
              "PAYEE_OF",
              "GUARANTOR_FOR",
              "BENEFICIARY_OF",
              "REFERENCES_CLAUSE",
              "LINKED_TO_CURRENCY",
              "SIGNED_BY",
              "FOOTNOTE_FOR"
            ]
          },
          "source_entity_id": {
            "type": "string"
          },
          "target_entity_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "quality_metadata": {
      "type": "object",
      "required": [
        "ocr_confidence_per_page",
        "annotation_difficulty",
        "time_to_annotate",
        "review_comments"
      ],
      "properties": {
        "ocr_confidence_per_page": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_number", "confidence"],
            "properties": {
              "page_number": {
                "type": "integer",
                "minimum": 1
              },
              "confidence": {
                "$ref": "#/$defs/confidence"
              }
            },
            "additionalProperties": false
          }
        },
        "annotation_difficulty": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "VERY_HIGH"]
        },
        "time_to_annotate": {
          "type": "number",
          "minimum": 0
        },
        "review_comments": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "version_control": {
      "type": "object",
      "required": [
        "schema_version",
        "annotation_guideline_version",
        "annotator_tool_version"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "annotation_guideline_version": {
          "type": "string"
        },
        "annotator_tool_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
